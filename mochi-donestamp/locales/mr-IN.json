    "support": {
        "metaTitle": "\u0938\u092a\u094b\u0930\u094d\u091f - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp \u0938\u093e\u0920\u0940 \u092e\u0926\u0924, \u0909\u0924\u094d\u0924\u0930\u0947 \u0906\u0923\u093f \u0938\u0902\u092a\u0930\u094d\u0915 \u092e\u093e\u0939\u093f\u0924\u0940.",
        "eyebrow": "\u0938\u092a\u094b\u0930\u094d\u091f",
        "heading": "\u0906\u092e\u094d\u0939\u0940 \u0915\u0936\u0940 \u092e\u0926\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",
        "deviceLine": "iPhone, iPad \u0906\u0923\u093f Apple Watch \u0938\u093e\u0920\u0940 Mochi DoneStamp",
        "sections": [
            {
                "title": "\u092e\u0940 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0915\u0938\u093e \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0942?",
                "body": "\u0938\u0927\u094d\u092f\u093e\u091a\u0940 \u0935\u0947\u0933 \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0915\u093e\u0930\u094d\u0921\u0935\u0930\u0940\u0932 \u0917\u094b\u0932 \u091a\u0947\u0915 \u092c\u091f\u0923\u093e\u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e. \u0924\u0933\u093e\u0936\u0940 \u090f\u0915 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 '\u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0915\u0930\u093e' \u0972\u0915\u094d\u0936\u0928 \u0926\u093f\u0938\u0947\u0932. \u0906\u0927\u0940\u091a\u0940 \u0924\u093e\u0930\u0940\u0916 \u0906\u0923\u093f \u0935\u0947\u0933 \u0928\u093f\u0935\u0921\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u094d\u092f\u093e\u091a \u092c\u091f\u0923\u093e\u0932\u093e \u0938\u094d\u092a\u0930\u094d\u0936 \u0915\u0930\u093e \u0906\u0923\u093f \u0927\u0930\u0942\u0928 \u0920\u0947\u0935\u093e."
            },
            {
                "title": "\u092a\u0941\u0922\u0940\u0932 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0915\u093e \u0939\u0932\u0935\u0932\u0947 \u0917\u0947\u0932\u0947?",
                "body": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0930\u093f\u0926\u092e \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937\u093e\u0924 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u0947\u0933\u0947\u092a\u093e\u0938\u0942\u0928 \u0930\u0940\u0938\u094d\u091f\u093e\u0930\u094d\u091f \u0939\u094b\u0924\u094b. \u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0940\u0928 \u0926\u093f\u0935\u0938 \u0909\u0936\u093f\u0930\u093e \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0947, \u0924\u0930 \u092a\u0941\u0922\u0940\u0932 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u091c\u0941\u0928\u0947 \u0936\u0947\u0921\u094d\u092f\u0941\u0932 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0910\u0935\u091c\u0940 \u0924\u094d\u092f\u093e \u0928\u0935\u0940\u0928 \u0935\u0947\u0933\u0947\u092a\u093e\u0938\u0942\u0928 \u0938\u0941\u0930\u0942 \u0939\u094b\u0924\u0947."
            },
            {
                "title": "\u092e\u0932\u093e \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930\u094d\u0938 \u0915\u093e \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924?",
                "body": "\u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0909\u0918\u0921\u093e, '\u0918\u091f\u0928\u093e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c' \u0928\u093f\u0935\u0921\u093e, \u0924\u094d\u092f\u093e\u0932\u093e \u0930\u093f\u0926\u092e \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0940 \u0906\u0923\u093f '\u092e\u0932\u093e \u0906\u0920\u0935\u0923 \u0915\u0930\u0942\u0928 \u0926\u094d\u092f\u093e' \u0938\u0915\u094d\u0937\u092e \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0940 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e, \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 iOS '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c' > '\u0938\u0942\u091a\u0928\u093e' > Mochi DoneStamp \u0924\u092a\u093e\u0938\u093e. \u0924\u0941\u092e\u094d\u0939\u0940 \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u091a\u093e\u0932\u0942 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930\u091a \u0972\u092a \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u092e\u093e\u0917\u0924\u094b."
            },
            {
                "title": "\u092e\u0940 Lifetime Pro \u0915\u0938\u0947 \u0930\u093f\u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u0930\u0942?",
                "body": "Mochi DoneStamp \u092e\u0927\u094d\u092f\u0947 '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c' \u0909\u0918\u0921\u093e, 'Mochi DoneStamp Pro' \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f '\u0916\u0930\u0947\u0926\u0940 \u092a\u0941\u0928\u0930\u094d\u0938\u0902\u091a\u092f\u093f\u0924 \u0915\u0930\u093e' \u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e. \u092e\u0942\u0933 \u0916\u0930\u0947\u0926\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092a\u0930\u0932\u0947\u0932\u0947\u091a Apple \u0905\u0915\u093e\u0909\u0902\u091f \u0935\u093e\u092a\u0930\u093e. Lifetime Pro \u0939\u0940 \u0938\u092c\u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 \u0928\u0938\u0942\u0928 \u0928\u0949\u0928-\u0915\u0928\u094d\u091d\u094d\u092f\u0941\u092e\u0947\u092c\u0932 \u0916\u0930\u0947\u0926\u0940 \u0906\u0939\u0947."
            },
            {
                "title": "\u092c\u0945\u0915\u0905\u092a\u094d\u0938 \u0915\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e\u0924?",
                "body": "Lifetime Pro \u0938\u0939, \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u093e \u0907\u0924\u093f\u0939\u093e\u0938 \u0906\u0923\u093f \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u094d\u092f\u093e \u092b\u094b\u091f\u094b\u0902\u0938\u0939 \u092a\u0942\u0930\u094d\u0923 JSON \u092c\u0945\u0915\u0905\u092a \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c' \u092e\u0927\u094d\u092f\u0947 '\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u093e' \u0928\u093f\u0935\u0921\u093e. \u0924\u0940 \u092b\u093e\u0908\u0932 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0936\u094d\u0935\u093e\u0938\u093e\u0924\u0940\u0932 \u0920\u093f\u0915\u093e\u0923\u0940 \u0920\u0947\u0935\u093e. \u0924\u0940 \u0930\u093f\u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, '\u0906\u092f\u093e\u0924 \u0915\u0930\u093e' \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u092c\u0945\u0915\u0905\u092a '\u0938\u0927\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0921\u0947\u091f\u093e\u0938\u094b\u092c\u0924 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u093e' \u0915\u093f\u0902\u0935\u093e '\u0938\u0927\u094d\u092f\u093e\u091a\u093e \u0921\u0947\u091f\u093e \u092c\u0926\u0932\u093e'."
            },
            {
                "title": "\u092b\u0945\u092e\u093f\u0932\u0940 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0915\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u0947?",
                "body": "\u090f\u0916\u093e\u0926\u093e \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0909\u0918\u0921\u093e, \u0932\u094b\u0915\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u092f\u0915\u0949\u0928\u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e \u0906\u0923\u093f '\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0938\u094b\u092c\u0924 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e' \u0928\u093f\u0935\u0921\u093e. Apple \u0928\u093f\u092e\u0902\u0924\u094d\u0930\u0923 \u0906\u0923\u093f \u0938\u0939\u092d\u093e\u0917\u0940 \u0915\u0902\u091f\u094d\u0930\u094b\u0932\u094d\u0938 \u0938\u093e\u0926\u0930 \u0915\u0930\u0924\u0947. CloudKit \u0936\u0947\u0905\u0930\u093f\u0902\u0917\u092e\u0927\u094d\u092f\u0947 \u092b\u094b\u091f\u094b \u0915\u0927\u0940\u0939\u0940 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0947\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924. \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u094d\u092f\u093e\u091a \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u092e\u0927\u0942\u0928 \u0938\u0939\u092d\u093e\u0917\u0940 \u092e\u0945\u0928\u0947\u091c \u0915\u0930\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0925\u093e\u0902\u092c\u0935\u0942 \u0936\u0915\u0924\u093e."
            },
            {
                "title": "\u092e\u0940 Apple Watch \u0935\u0930 \u0915\u093e\u092f \u0915\u0930\u0942 \u0936\u0915\u0924\u094b?",
                "body": "\u0915\u0902\u092a\u0945\u0928\u093f\u092f\u0928 \u0972\u092a \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e iPhone \u0935\u0930\u0942\u0928 \u0938\u093f\u0902\u0915 \u0915\u0947\u0932\u0947\u0932\u0947 \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u094d\u0938 \u0926\u093e\u0916\u0935\u0924\u094b. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u0928\u0917\u091f\u093e\u0935\u0930\u0942\u0928 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091a\u0947\u0915 \u092c\u091f\u0923\u093e\u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e. \u092c\u0926\u0932 iPhone \u0935\u0930 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u094d\u092f\u093e \u0921\u093f\u0938\u094d\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0926\u0930\u092e\u094d\u092f\u093e\u0928 \u0938\u0930\u094d\u0935\u093e\u0924 \u0905\u0932\u0940\u0915\u0921\u0940\u0932 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0932\u093f\u0938\u094d\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u093e\u0939\u0924\u0947."
            }
        ],
        "contactTitle": "\u0938\u0902\u092a\u0930\u094d\u0915",
        "contactBody": "\u0924\u0941\u092e\u091a\u0940 iOS \u0915\u093f\u0902\u0935\u093e watchOS \u0906\u0935\u0943\u0924\u094d\u0924\u0940, \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u091a\u0947 \u092e\u0949\u0921\u0947\u0932 \u0906\u0923\u093f \u0915\u093e\u092f \u091d\u093e\u0932\u0947 \u092f\u093e\u091a\u0947 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u0930\u094d\u0923\u0928 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u093e. \u0915\u0943\u092a\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u0938\u0932\u094d\u092f\u093e\u0936\u093f\u0935\u093e\u092f \u0916\u093e\u091c\u0917\u0940 \u0928\u094b\u091f\u094d\u0938, \u092b\u094b\u091f\u094b \u0915\u093f\u0902\u0935\u093e \u092c\u0945\u0915\u0905\u092a \u092b\u093e\u0908\u0932\u094d\u0938 \u092a\u093e\u0920\u0935\u0942 \u0928\u0915\u093e.",
        "contactButton": "\u0938\u092a\u094b\u0930\u094d\u091f\u0932\u093e \u0908\u092e\u0947\u0932 \u0915\u0930\u093e"
    },
    "privacy": {
        "metaTitle": "\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923 - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923: \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0905\u0915\u093e\u0909\u0902\u091f \u0928\u093e\u0939\u0940, \u091c\u093e\u0939\u093f\u0930\u093e\u0924\u0940 \u0928\u093e\u0939\u0940\u0924, \u0972\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0928\u093e\u0939\u0940.",
        "eyebrow": "\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e",
        "heading": "\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923",
        "effectiveDate": "\u092a\u094d\u0930\u092d\u093e\u0935\u0940: 17 \u091c\u0941\u0932\u0948 2026",
        "sections": [
            {
                "title": "\u0938\u093e\u0930\u093e\u0902\u0936",
                "body": "Mochi DoneStamp \u0932\u093e \u0905\u0915\u093e\u0909\u0902\u091f\u091a\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u091c\u093e\u0939\u093f\u0930\u093e\u0924\u0940, \u0972\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938, \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0915\u093f\u0902\u0935\u093e \u0925\u0930\u094d\u0921-\u092a\u093e\u0930\u094d\u091f\u0940 SDK \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0928\u093e\u0939\u0940\u0924. \u092f\u093e\u091a\u093e \u092e\u0941\u0916\u094d\u092f \u0935\u093e\u092a\u0930 \u0911\u092b\u0932\u093e\u0907\u0928 \u0906\u0939\u0947. Lumi Studio \u092f\u093e \u0972\u092a\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935\u094d\u0939\u0930 \u091a\u093e\u0932\u0935\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930\u0940\u0932 \u0915\u0902\u091f\u0947\u0902\u091f \u0935\u093e\u091a\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930 \u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u093e \u0921\u0947\u091f\u093e",
                "body": "\u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u0940 \u0928\u093e\u0935\u0947, \u091a\u093f\u0928\u094d\u0939\u0947, \u0930\u0902\u0917, \u0930\u093f\u0926\u092e\u094d\u0938, \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c, \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u094d\u092f\u093e\u091a\u093e \u0907\u0924\u093f\u0939\u093e\u0938, \u0928\u094b\u091f\u094d\u0938 \u0906\u0923\u093f \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u0947 \u092b\u094b\u091f\u094b \u0972\u092a\u091a\u094d\u092f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924 App Group \u0915\u0902\u091f\u0947\u0928\u0930\u092e\u0927\u094d\u092f\u0947 \u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u093e\u0924 \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0972\u092a, \u0935\u093f\u091c\u0947\u091f\u094d\u0938, \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0972\u0915\u094d\u0936\u0928\u094d\u0938 \u0906\u0923\u093f App Intents \u0924\u094b\u091a \u0921\u0947\u091f\u093e \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u0940\u0932. Apple \u091a\u094d\u092f\u093e WatchConnectivity \u0938\u0947\u0935\u0947\u0926\u094d\u0935\u093e\u0930\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e Apple Watch \u0935\u0930 \u096b\u0966 \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u094d\u0938\u092a\u0930\u094d\u092f\u0902\u0924\u091a\u093e \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0938\u094d\u0928\u0945\u092a\u0936\u0949\u091f \u092a\u093e\u0920\u0935\u0932\u093e \u091c\u093e\u0924\u094b. \u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u0940 \u0928\u093e\u0935\u0947, \u091a\u093f\u0928\u094d\u0939\u0947, \u0930\u0902\u0917, \u092a\u0942\u0930\u094d\u0923\u0924\u094d\u0935\u093e\u091a\u0940 \u0906\u0923\u093f \u0926\u0947\u092f \u0935\u0947\u0933, \u0925\u0915\u0940\u0924, \u092a\u093f\u0928 \u0906\u0923\u093f \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0938\u094d\u0925\u093f\u0924\u0940, \u0910\u091a\u094d\u091b\u093f\u0915 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u093e\u0931\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935 \u0906\u0923\u093f \u0972\u092a\u091a\u0940 \u092d\u093e\u0937\u093e \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0905\u0938\u0924\u0947; \u0928\u094b\u091f\u094d\u0938 \u0906\u0923\u093f \u092b\u094b\u091f\u094b Watch \u0935\u0930 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924. Watch \u0935\u0930 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 WatchConnectivity \u0926\u094d\u0935\u093e\u0930\u0947 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0906\u0923\u093f \u0911\u0915\u0930\u0928\u094d\u0938 \u0906\u092f\u0921\u0947\u0902\u091f\u093f\u092b\u093e\u092f\u0930\u094d\u0938 \u0924\u0938\u0947\u091a \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u094d\u092f\u093e\u091a\u0940 \u0935\u0947\u0933 \u092a\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e iPhone \u0915\u0921\u0947 \u092a\u0930\u0924 \u092a\u093e\u0920\u0935\u0932\u0940 \u091c\u093e\u0924\u0947. \u092f\u093e\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0915\u0902\u091f\u0947\u0902\u091f Lumi Studio \u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0932\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "\u092b\u094b\u091f\u094b",
                "body": "\u092b\u094b\u091f\u094b \u0910\u091a\u094d\u091b\u093f\u0915 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u0947 \u0906\u0939\u0947\u0924. Mochi DoneStamp \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u094d\u092f\u093e \u0907\u0924\u093f\u0939\u093e\u0938\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u0915\u0949\u092e\u094d\u092a\u094d\u0930\u0947\u0938\u094d\u0921 \u0916\u093e\u091c\u0917\u0940 \u0915\u0949\u092a\u0940 \u0924\u092f\u093e\u0930 \u0915\u0930\u0924\u094b. \u0924\u094b \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u0947 \u092b\u094b\u091f\u094b Lumi Studio \u0935\u0930 \u0905\u092a\u0932\u094b\u0921 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0924\u094d\u092f\u093e\u0902\u0928\u093e CloudKit \u092b\u0945\u092e\u093f\u0932\u0940 \u0936\u0947\u0905\u0930\u093f\u0902\u0917\u092e\u0927\u094d\u092f\u0947 \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0915\u0930\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "iCloud \u0926\u094d\u0935\u093e\u0930\u0947 \u0910\u091a\u094d\u091b\u093f\u0915 \u092b\u0945\u092e\u093f\u0932\u0940 \u0936\u0947\u0905\u0930\u093f\u0902\u0917",
                "body": "\u0924\u0941\u092e\u094d\u0939\u0940 '\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0938\u094b\u092c\u0924 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e' \u0928\u093f\u0935\u0921\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930\u091a \u092b\u0945\u092e\u093f\u0932\u0940 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0938\u0941\u0930\u0942 \u0939\u094b\u0924\u0947. Apple \u091a\u0947 \u0916\u093e\u091c\u0917\u0940 \u0906\u0923\u093f \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u0947 CloudKit \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0928\u0902\u0924\u0930 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0906\u0923\u093f \u0911\u0915\u0930\u0928\u094d\u0938 \u0906\u092f\u0921\u0947\u0902\u091f\u093f\u092b\u093e\u092f\u0930\u094d\u0938; \u0907\u0935\u094d\u0939\u0947\u0902\u091f\u091a\u0947 \u0928\u093e\u0935, \u091a\u093f\u0928\u094d\u0939, \u0930\u0902\u0917, \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0911\u0930\u094d\u0921\u0930, \u092a\u093f\u0928 \u0915\u0947\u0932\u0947\u0932\u0947 \u0915\u093f\u0902\u0935\u093e \u0906\u0930\u094d\u0915\u093e\u0907\u0935\u094d\u0939 \u0915\u0947\u0932\u0947\u0932\u0947 \u0938\u094d\u091f\u0947\u091f\u0938, \u0930\u093f\u0915\u0930\u0928\u094d\u0938 \u0906\u0923\u093f \u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c, \u0928\u093f\u0930\u094d\u092e\u093f\u0924\u0940 \u0906\u0923\u093f \u0905\u092a\u0921\u0947\u091f\u091a\u094d\u092f\u093e \u0935\u0947\u0933\u093e; \u0906\u0923\u093f \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0935\u0947\u0933\u093e, \u0938\u094d\u0930\u094b\u0924, \u0928\u094b\u091f\u094d\u0938, \u0906\u0923\u093f \u0938\u0939\u092d\u093e\u0917\u0940 \u0906\u092f\u0921\u0947\u0902\u091f\u093f\u092b\u093e\u092f\u0930\u094d\u0938 \u0906\u0923\u093f \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0928\u093e\u0935\u0947 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u0930\u0924\u093e\u0924. \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u0947 \u092b\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924. \u0915\u0947\u0935\u0933 \u0924\u0941\u092e\u094d\u0939\u0940 Apple \u091a\u094d\u092f\u093e \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0907\u0902\u091f\u0930\u092b\u0947\u0938\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u0947 \u0932\u094b\u0915\u091a \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u093e \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0972\u0915\u094d\u0938\u0947\u0938 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. Lumi Studio \u0924\u094b \u0915\u0902\u091f\u0947\u0902\u091f \u0972\u0915\u094d\u0938\u0947\u0938 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940. \u0924\u0941\u092e\u094d\u0939\u0940 \u0972\u092a\u092e\u0927\u094d\u092f\u0947 \u0938\u0939\u092d\u093e\u0917\u0940 \u092e\u0945\u0928\u0947\u091c \u0915\u0930\u0942 \u0936\u0915\u0924\u093e, \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0925\u093e\u0902\u092c\u0935\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u093e \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e. Apple \u091a\u0947 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e iCloud \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0926\u0947\u0916\u0940\u0932 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e\u0924."
            },
            {
                "title": "\u0916\u0930\u0947\u0926\u0940",
                "body": "Lifetime Pro \u091a\u0940 \u0916\u0930\u0947\u0926\u0940 \u0906\u0923\u093f \u0930\u093f\u0938\u094d\u091f\u094b\u0930\u0947\u0936\u0928 Apple \u0926\u094d\u0935\u093e\u0930\u0947 StoreKit \u091a\u094d\u092f\u093e \u092e\u093e\u0927\u094d\u092f\u092e\u093e\u0924\u0942\u0928 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947. Lumi Studio \u0932\u093e \u0924\u0941\u092e\u091a\u0947 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u093e\u0930\u094d\u0921 \u0921\u093f\u091f\u0947\u0932\u094d\u0938 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924 \u0915\u093f\u0902\u0935\u093e \u0924\u0947 \u0938\u094d\u091f\u094b\u0905\u0930 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924. Apple \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0927\u094b\u0930\u0923\u093e\u0902\u0924\u0930\u094d\u0917\u0924 \u0916\u0930\u0947\u0926\u0940 \u092e\u093e\u0939\u093f\u0924\u0940\u0935\u0930 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0942 \u0936\u0915\u0924\u0947."
            },
            {
                "title": "\u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928\u094d\u0938",
                "body": "\u0930\u093f\u092e\u093e\u0907\u0902\u0921\u0930 \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928\u094d\u0938 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930 \u0932\u094b\u0915\u0932\u0940 \u0936\u0947\u0921\u094d\u092f\u0941\u0932 \u0915\u0947\u0932\u0947\u0932\u0940 \u0905\u0938\u0924\u093e\u0924. \u0924\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e '\u092a\u0942\u0930\u094d\u0923' \u0906\u0923\u093f '\u0938\u094d\u0928\u0942\u091d' \u0972\u0915\u094d\u0936\u0928\u094d\u0938 \u0924\u094b\u091a \u0932\u094b\u0915\u0932 App Group \u0921\u0947\u091f\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0924\u093e\u0924. Mochi DoneStamp \u0930\u093f\u092e\u094b\u091f \u0928\u094b\u091f\u093f\u092b\u093f\u0915\u0947\u0936\u0928 \u0938\u0930\u094d\u0935\u094d\u0939\u0930 \u0935\u093e\u092a\u0930\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "\u0906\u0930\u094d\u091f\u093f\u092b\u093f\u0936\u093f\u092f\u0932 \u0907\u0902\u091f\u0947\u0932\u093f\u091c\u0928\u094d\u0938",
                "body": "Mochi DoneStamp \u092c\u093e\u0939\u094d\u092f AI \u0915\u093f\u0902\u0935\u093e \u092e\u0949\u0921\u0947\u0932 \u092a\u094d\u0930\u094b\u0935\u094d\u0939\u093e\u092f\u0921\u0930 \u0935\u093e\u092a\u0930\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u0921\u0947\u091f\u093e \u092e\u0949\u0921\u0947\u0932\u0915\u0921\u0947 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940. \u0924\u0938\u0947\u091a \u0924\u094b \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930\u0940\u0932 \u0915\u0902\u091f\u0947\u0902\u091f\u0935\u0930 \u092e\u0949\u0921\u0947\u0932 \u0930\u0928 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "\u0972\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938, \u091c\u093e\u0939\u093f\u0930\u093e\u0924\u0940 \u0906\u0923\u093f \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917",
                "body": "Mochi DoneStamp \u092e\u0927\u094d\u092f\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u091c\u093e\u0939\u093f\u0930\u093e\u0924\u0940 \u0915\u093f\u0902\u0935\u093e \u0972\u0928\u093e\u0932\u093f\u091f\u093f\u0915\u094d\u0938 SDK \u0928\u093e\u0939\u0940, \u0924\u094b \u0972\u092a\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094d\u0938\u0935\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u091f\u094d\u0930\u0945\u0915 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u0935\u093f\u0915\u0924 \u0928\u093e\u0939\u0940."
            },
            {
                "title": "\u092c\u0945\u0915\u0905\u092a\u094d\u0938, \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f\u094d\u0938 \u0906\u0923\u093f \u0930\u093f\u091f\u0947\u0928\u094d\u0936\u0928",
                "body": "\u0915\u0947\u0935\u0933 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930\u091a \u092c\u0945\u0915\u0905\u092a\u094d\u0938 \u0906\u0923\u093f JSON \u090f\u0915\u094d\u0938\u092a\u094b\u0930\u094d\u091f\u094d\u0938 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u0941\u092e\u094d\u0939\u0940 \u0928\u093f\u0935\u0921\u0932\u0947\u0932\u094d\u092f\u093e \u0932\u094b\u0915\u0947\u0936\u0928\u0935\u0930 \u0938\u0947\u0935\u094d\u0939 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u093e\u0924. \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u094d\u092f\u093e \u092b\u093e\u0908\u0932\u094d\u0938 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0906\u0923\u093f \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0924\u093e. \u091c\u094b\u092a\u0930\u094d\u092f\u0902\u0924 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0947 \u090f\u0921\u093f\u091f \u0915\u093f\u0902\u0935\u093e \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0924 \u0928\u093e\u0939\u0940, \u0972\u092a \u0930\u0940\u0938\u0947\u091f \u0915\u0930\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e iOS \u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u0924 \u0928\u093e\u0939\u0940 \u0924\u094b\u092a\u0930\u094d\u092f\u0902\u0924 \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930\u0940\u0932 \u0915\u0902\u091f\u0947\u0902\u091f \u0930\u093e\u0939\u0924\u094b. \u092a\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u0947 Apple Watch \u0924\u094d\u092f\u093e\u091a\u093e \u0938\u0930\u094d\u0935\u093e\u0924 \u0905\u0932\u0940\u0915\u0921\u0940\u0932 \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0938\u094d\u0928\u0945\u092a\u0936\u0949\u091f \u0928\u0935\u0940\u0928 \u0938\u094d\u0928\u0945\u092a\u0936\u0949\u091f\u0926\u094d\u0935\u093e\u0930\u0947 \u092c\u0926\u0932\u0932\u093e \u091c\u093e\u0908\u092a\u0930\u094d\u092f\u0902\u0924 \u0915\u093f\u0902\u0935\u093e Watch \u0972\u092a \u0915\u093e\u0922\u0942\u0928 \u091f\u093e\u0915\u0932\u0947 \u091c\u093e\u0908\u092a\u0930\u094d\u092f\u0902\u0924 \u0920\u0947\u0935\u0924\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0925\u093e\u0902\u092c\u0935\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0915\u093f\u0902\u0935\u093e \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u093e \u0907\u0935\u094d\u0939\u0947\u0902\u091f \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0947\u092a\u0930\u094d\u092f\u0902\u0924 \u0936\u0947\u0905\u0930 \u0915\u0947\u0932\u0947\u0932\u093e \u0915\u0902\u091f\u0947\u0902\u091f CloudKit \u092e\u0927\u094d\u092f\u0947 \u0930\u093e\u0939\u0924\u094b, \u091c\u094b Apple \u091a\u094d\u092f\u093e \u0938\u0930\u094d\u0935\u093f\u0938 \u0939\u0901\u0921\u0932\u093f\u0902\u0917\u091a\u094d\u092f\u093e \u0905\u0927\u0940\u0928 \u0906\u0939\u0947."
            }
