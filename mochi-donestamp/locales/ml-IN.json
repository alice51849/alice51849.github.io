    "navPrivacy": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24",
    "support": {
        "metaTitle": "\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp-\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d38\u0d39\u0d3e\u0d2f\u0d02, \u0d09\u0d24\u0d4d\u0d24\u0d30\u0d19\u0d4d\u0d19\u0d7e, \u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d3e\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e.",
        "eyebrow": "\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23",
        "heading": "\u0d1e\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d38\u0d39\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d3e\u0d15\u0d41\u0d02?",
        "deviceLine": "iPhone, iPad, Apple Watch \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 Mochi DoneStamp",
        "sections": [
            {
                "title": "\u0d12\u0d30\u0d41 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d1e\u0d3e\u0d7b \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d02?",
                "body": "\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d38\u0d2e\u0d2f\u0d02 \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d12\u0d30\u0d41 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d3f\u0d32\u0d46 \u0d31\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d1f\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d1a\u0d41\u0d30\u0d41\u0d15\u0d4d\u0d15\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 '\u0d2a\u0d34\u0d2f\u0d2a\u0d1f\u0d3f\u0d2f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15' \u0d06\u0d15\u0d4d\u0d37\u0d7b \u0d24\u0d3e\u0d34\u0d46 \u0d15\u0d3e\u0d23\u0d3e\u0d02. \u0d2e\u0d41\u0d2e\u0d4d\u0d2a\u0d24\u0d4d\u0d24\u0d46 \u0d24\u0d40\u0d2f\u0d24\u0d3f\u0d2f\u0d41\u0d02 \u0d38\u0d2e\u0d2f\u0d35\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d05\u0d24\u0d47 \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d38\u0d4d\u0d2a\u0d7c\u0d36\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d2a\u0d3f\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15."
            },
            {
                "title": "\u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d2e\u0d3e\u0d31\u0d3f\u0d2f\u0d24\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d?",
                "body": "\u0d13\u0d30\u0d4b \u0d24\u0d3e\u0d33\u0d35\u0d41\u0d02 \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23 \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d4d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d3e\u0d23\u0d4d \u0d2a\u0d41\u0d28\u0d30\u0d3e\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d2e\u0d42\u0d28\u0d4d\u0d28\u0d4d \u0d26\u0d3f\u0d35\u0d38\u0d02 \u0d35\u0d48\u0d15\u0d3f \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d3e\u0d23\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d, \u0d2a\u0d34\u0d2f \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d2a\u0d15\u0d30\u0d02 \u0d06 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d4d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41."
            },
            {
                "title": "\u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d41\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d31\u0d41\u0d15\u0d7e \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32?",
                "body": "\u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15, '\u0d38\u0d02\u0d2d\u0d35 \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e' \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d05\u0d24\u0d3f\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d33\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 '\u0d0e\u0d28\u0d4d\u0d28\u0d46 \u0d13\u0d7c\u0d2e\u0d4d\u0d2e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d15\u0d4d\u0d37\u0d2e\u0d2e\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d28\u0d4d\u0d28\u0d41\u0d02 \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d24\u0d41\u0d1f\u0d7c\u0d28\u0d4d\u0d28\u0d4d iOS '\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e' > '\u0d05\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e' > Mochi DoneStamp \u0d2a\u0d30\u0d3f\u0d36\u0d4b\u0d27\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d12\u0d30\u0d41 \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d13\u0d23\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d2f \u0d36\u0d47\u0d37\u0d02 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d05\u0d28\u0d41\u0d2e\u0d24\u0d3f \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d42."
            },
            {
                "title": "Lifetime Pro \u0d1e\u0d3e\u0d7b \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46 \u0d2a\u0d41\u0d28\u0d03\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d02?",
                "body": "Mochi DoneStamp-\u0d7d '\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e' \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15, 'Mochi DoneStamp Pro' \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d36\u0d47\u0d37\u0d02 '\u0d35\u0d3e\u0d19\u0d4d\u0d19\u0d7d \u0d2a\u0d41\u0d28\u0d03\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15' \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d1f\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2a\u0d7c\u0d1a\u0d4d\u0d1a\u0d47\u0d38\u0d4d \u0d28\u0d1f\u0d24\u0d4d\u0d24\u0d3f\u0d2f \u0d05\u0d24\u0d47 Apple \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. Lifetime Pro \u0d12\u0d30\u0d41 \u0d28\u0d4b\u0d7a-\u0d15\u0d7a\u0d38\u0d4d\u0d2f\u0d42\u0d2e\u0d2c\u0d3f\u0d7e \u0d2a\u0d7c\u0d1a\u0d4d\u0d1a\u0d47\u0d38\u0d3e\u0d23\u0d4d, \u0d38\u0d2c\u0d4d\u0d38\u0d4d\u0d15\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d37\u0d28\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d3e\u0d23\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d?",
                "body": "Lifetime Pro \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d, \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d35\u0d41\u0d02 \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d33\u0d41\u0d02 \u0d09\u0d7e\u0d15\u0d4d\u0d15\u0d4a\u0d33\u0d4d\u0d33\u0d41\u0d28\u0d4d\u0d28 \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d2e\u0d3e\u0d2f JSON \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d4d \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b '\u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e' \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d7d '\u0d0e\u0d15\u0d4d\u0d38\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d' \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d06 \u0d2b\u0d2f\u0d7d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d35\u0d3f\u0d36\u0d4d\u0d35\u0d3e\u0d38\u0d2e\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d3f\u0d1f\u0d24\u0d4d\u0d24\u0d4d \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d05\u0d24\u0d4d \u0d2a\u0d41\u0d28\u0d03\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b, '\u0d07\u0d02\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d4d' \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d4d \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d4d '\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d38\u0d02\u0d2f\u0d4b\u0d1c\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15' \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d '\u0d28\u0d3f\u0d32\u0d35\u0d3f\u0d32\u0d46 \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15'."
            },
            {
                "title": "\u0d2b\u0d3e\u0d2e\u0d3f\u0d32\u0d3f \u0d37\u0d46\u0d2f\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d0e\u0d19\u0d4d\u0d19\u0d28\u0d46\u0d2f\u0d3e\u0d23\u0d4d \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d?",
                "body": "\u0d12\u0d30\u0d41 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d24\u0d41\u0d31\u0d15\u0d4d\u0d15\u0d41\u0d15, \u0d06\u0d33\u0d41\u0d15\u0d33\u0d41\u0d1f\u0d46 \u0d10\u0d15\u0d4d\u0d15\u0d7a \u0d1f\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15, \u0d36\u0d47\u0d37\u0d02 '\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d41\u0d15' \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d15\u0d4d\u0d37\u0d23\u0d02, \u0d2a\u0d19\u0d4d\u0d15\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 Apple \u0d05\u0d35\u0d24\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. CloudKit \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d32\u0d3f\u0d7d \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e \u0d12\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d32\u0d41\u0d02 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d19\u0d4d\u0d15\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d35\u0d30\u0d46 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d05\u0d24\u0d47 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d7d \u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02."
            },
            {
                "title": "Apple Watch-\u0d7d \u0d0e\u0d28\u0d3f\u0d15\u0d4d\u0d15\u0d4d \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02?",
                "body": "\u0d2a\u0d46\u0d2f\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d1f\u0d4d\u0d1f\u0d41\u0d33\u0d4d\u0d33 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 iPhone-\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d38\u0d3f\u0d19\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d15\u0d2e\u0d4d\u0d2a\u0d3e\u0d28\u0d3f\u0d2f\u0d7b \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d15\u0d3e\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d48\u0d24\u0d4d\u0d24\u0d23\u0d4d\u0d1f\u0d2f\u0d3f\u0d7d \u0d28\u0d3f\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d1a\u0d46\u0d15\u0d4d\u0d15\u0d4d \u0d2c\u0d1f\u0d4d\u0d1f\u0d7a \u0d1f\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15. iPhone-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d2f\u0d2f\u0d4d\u200c\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d12\u0d30\u0d41 \u0d24\u0d3e\u0d7d\u0d15\u0d4d\u0d15\u0d3e\u0d32\u0d3f\u0d15 \u0d21\u0d3f\u0d38\u0d4d\u200c\u0d15\u0d23\u0d15\u0d4d\u0d37\u0d7b \u0d38\u0d2e\u0d2f\u0d24\u0d4d\u0d24\u0d4d \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d32\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d4d \u0d32\u0d2d\u0d4d\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d02."
            }
        ],
        "contactTitle": "\u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15",
        "contactBody": "\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 iOS \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d watchOS \u0d35\u0d47\u0d7c\u0d37\u0d7b, \u0d09\u0d2a\u0d15\u0d30\u0d23 \u0d2e\u0d4b\u0d21\u0d7d, \u0d0e\u0d28\u0d4d\u0d24\u0d4d \u0d38\u0d02\u0d2d\u0d35\u0d3f\u0d1a\u0d4d\u0d1a\u0d41 \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d12\u0d30\u0d41 \u0d32\u0d18\u0d41\u0d35\u0d3f\u0d35\u0d30\u0d23\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d15. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d05\u0d2d\u0d4d\u0d2f\u0d7c\u0d24\u0d4d\u0d25\u0d28\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d24\u0d4d\u0d2f\u0d28\u0d4d\u0d24\u0d3e\u0d2a\u0d47\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d2e\u0d32\u0d4d\u0d32\u0d3e\u0d24\u0d4d\u0d24 \u0d2a\u0d15\u0d4d\u0d37\u0d02 \u0d26\u0d2f\u0d35\u0d3e\u0d2f\u0d3f \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d4b \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d33\u0d4b \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d4d \u0d2b\u0d2f\u0d32\u0d41\u0d15\u0d33\u0d4b \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d30\u0d41\u0d24\u0d4d.",
        "contactButton": "\u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d1f\u0d40\u0d2e\u0d3f\u0d28\u0d4d \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"
    },
    "privacy": {
        "metaTitle": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d02 - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d02: \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d07\u0d32\u0d4d\u0d32, \u0d2a\u0d30\u0d38\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d3f\u0d32\u0d4d\u0d32, \u0d05\u0d28\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d \u0d07\u0d32\u0d4d\u0d32, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d07\u0d32\u0d4d\u0d32.",
        "eyebrow": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24",
        "heading": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d02",
        "effectiveDate": "\u0d2a\u0d4d\u0d30\u0d3e\u0d2c\u0d32\u0d4d\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d7d: 17 \u0d1c\u0d42\u0d32\u0d48 2026",
        "sections": [
            {
                "title": "\u0d38\u0d02\u0d17\u0d4d\u0d30\u0d39\u0d02",
                "body": "Mochi DoneStamp-\u0d28\u0d4d \u0d12\u0d30\u0d41 \u0d05\u0d15\u0d4d\u0d15\u0d57\u0d23\u0d4d\u0d1f\u0d4d \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2e\u0d3f\u0d32\u0d4d\u0d32, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d2a\u0d30\u0d38\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d7d, \u0d05\u0d28\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d, \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d24\u0d47\u0d7c\u0d21\u0d4d-\u0d2a\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f SDK-\u0d15\u0d7e \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32. \u0d07\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d02 \u0d13\u0d2b\u0d4d\u200c\u0d32\u0d48\u0d28\u0d3e\u0d23\u0d4d. Lumi Studio \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d3e\u0d2f\u0d3f \u0d12\u0d30\u0d41 \u0d38\u0d46\u0d7c\u0d35\u0d7c \u0d2a\u0d4d\u0d30\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d4d \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d41\u0d02 \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d21\u0d3e\u0d31\u0d4d\u0d31",
                "body": "\u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d7e, \u0d1a\u0d3f\u0d39\u0d4d\u0d28\u0d19\u0d4d\u0d19\u0d7e, \u0d28\u0d3f\u0d31\u0d19\u0d4d\u0d19\u0d7e, \u0d24\u0d3e\u0d33\u0d19\u0d4d\u0d19\u0d7e, \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e, \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23 \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d02, \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d41\u0d30\u0d15\u0d4d\u0d37\u0d3f\u0d24\u0d2e\u0d3e\u0d2f App Group \u0d15\u0d23\u0d4d\u0d1f\u0d46\u0d2f\u0d4d\u200c\u0d28\u0d31\u0d3f\u0d7d \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d1a\u0d4d\u0d1a\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41, \u0d05\u0d24\u0d3f\u0d28\u0d3e\u0d7d \u0d06\u0d2a\u0d4d\u0d2a\u0d4d, \u0d35\u0d3f\u0d21\u0d4d\u0d1c\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d7e, \u0d28\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d06\u0d15\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e, App Intents \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d12\u0d30\u0d47 \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. Apple-\u0d28\u0d4d\u0d31\u0d46 WatchConnectivity \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d35\u0d34\u0d3f \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d46\u0d2f\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 Apple Watch-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d 50 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d7e \u0d35\u0d30\u0d46\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d12\u0d30\u0d41 \u0d2a\u0d30\u0d3f\u0d2e\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d38\u0d4d\u0d28\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d07\u0d24\u0d3f\u0d7d \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d7e, \u0d1a\u0d3f\u0d39\u0d4d\u0d28\u0d19\u0d4d\u0d19\u0d7e, \u0d28\u0d3f\u0d31\u0d19\u0d4d\u0d19\u0d7e, \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23\u0d35\u0d41\u0d02 \u0d05\u0d35\u0d38\u0d3e\u0d28 \u0d38\u0d2e\u0d2f\u0d35\u0d41\u0d02, \u0d13\u0d35\u0d7c\u0d21\u0d4d\u0d2f\u0d42, \u0d2a\u0d3f\u0d7b, \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d7d \u0d28\u0d3f\u0d32, \u0d13\u0d2a\u0d4d\u0d37\u0d23\u0d32\u0d3e\u0d2f \u0d12\u0d30\u0d41 \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23 \u0d28\u0d3e\u0d2e\u0d02, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d2d\u0d3e\u0d37 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d28\u0d4d\u0d28\u0d41; \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d33\u0d41\u0d02 Watch-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32. Watch-\u0d7d \u0d12\u0d30\u0d41 \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d31\u0d46\u0d15\u0d4d\u0d15\u0d4b\u0d7c\u0d21\u0d41\u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d, \u0d13\u0d15\u0d4d\u0d15\u0d31\u0d7b\u0d38\u0d4d \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d2b\u0d2f\u0d31\u0d41\u0d15\u0d7e, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23 \u0d38\u0d2e\u0d2f\u0d02 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 WatchConnectivity \u0d35\u0d34\u0d3f \u0d2a\u0d46\u0d2f\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 iPhone-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d46 \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d08 \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d41\u0d15\u0d33\u0d4a\u0d28\u0d4d\u0d28\u0d41\u0d02 Lumi Studio-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d15\u0d4d\u0d15\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e",
                "body": "\u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e \u0d13\u0d2a\u0d4d\u0d37\u0d23\u0d32\u0d3e\u0d23\u0d4d, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3e\u0d23\u0d4d. \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d1a\u0d30\u0d3f\u0d24\u0d4d\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d3e\u0d2f\u0d3f Mochi DoneStamp \u0d15\u0d02\u0d2a\u0d4d\u0d30\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d12\u0d30\u0d41 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f \u0d2a\u0d15\u0d7c\u0d2a\u0d4d\u0d2a\u0d4d \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d07\u0d24\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d4d\u0d1f \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e Lumi Studio-\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d CloudKit \u0d2b\u0d3e\u0d2e\u0d3f\u0d32\u0d3f \u0d37\u0d46\u0d2f\u0d31\u0d3f\u0d02\u0d17\u0d3f\u0d7d \u0d09\u0d7e\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d2f\u0d4b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "iCloud \u0d35\u0d34\u0d3f\u0d2f\u0d41\u0d33\u0d4d\u0d33 \u0d13\u0d2a\u0d4d\u0d37\u0d23\u0d7d \u0d2b\u0d3e\u0d2e\u0d3f\u0d32\u0d3f \u0d37\u0d46\u0d2f\u0d31\u0d3f\u0d02\u0d17\u0d4d",
                "body": "\u0d15\u0d41\u0d1f\u0d41\u0d02\u0d2c\u0d35\u0d41\u0d2e\u0d3e\u0d2f\u0d3f \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d41\u0d15 \u0d0e\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d36\u0d47\u0d37\u0d02 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d2b\u0d3e\u0d2e\u0d3f\u0d32\u0d3f \u0d37\u0d46\u0d2f\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d42. Apple-\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f, \u0d37\u0d46\u0d2f\u0d47\u0d7c\u0d21\u0d4d CloudKit \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d3e\u0d2c\u0d47\u0d38\u0d41\u0d15\u0d7e \u0d2a\u0d3f\u0d28\u0d4d\u0d28\u0d40\u0d1f\u0d4d \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d, \u0d13\u0d15\u0d4d\u0d15\u0d31\u0d7b\u0d38\u0d4d \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d2b\u0d2f\u0d31\u0d41\u0d15\u0d7e; \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d47\u0d30\u0d4d, \u0d1a\u0d3f\u0d39\u0d4d\u0d28\u0d02, \u0d28\u0d3f\u0d31\u0d02, \u0d21\u0d3f\u0d38\u0d4d\u0d2a\u0d4d\u0d32\u0d47 \u0d13\u0d7c\u0d21\u0d7c, \u0d2a\u0d3f\u0d7b \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d06\u0d7c\u0d15\u0d4d\u0d15\u0d48\u0d35\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24 \u0d28\u0d3f\u0d32, \u0d06\u0d35\u0d7c\u0d24\u0d4d\u0d24\u0d28\u0d02, \u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d7e, \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a\u0d24\u0d41\u0d02 \u0d05\u0d2a\u0d4d\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d24\u0d41\u0d2e\u0d3e\u0d2f \u0d38\u0d2e\u0d2f\u0d19\u0d4d\u0d19\u0d7e; \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d40\u0d15\u0d30\u0d23 \u0d38\u0d2e\u0d2f\u0d02, \u0d09\u0d31\u0d35\u0d3f\u0d1f\u0d02, \u0d15\u0d41\u0d31\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d2a\u0d19\u0d4d\u0d15\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d10\u0d21\u0d28\u0d4d\u0d31\u0d3f\u0d2b\u0d2f\u0d31\u0d41\u0d15\u0d7e, \u0d21\u0d3f\u0d38\u0d4d\u0d2a\u0d4d\u0d32\u0d47 \u0d2a\u0d47\u0d30\u0d41\u0d15\u0d7e \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d24\u0d4d\u0d24 \u0d2b\u0d4b\u0d1f\u0d4d\u0d1f\u0d4b\u0d15\u0d7e \u0d05\u0d2a\u0d4d\u200c\u0d32\u0d4b\u0d21\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3f\u0d32\u0d4d\u0d32. Apple-\u0d28\u0d4d\u0d31\u0d46 \u0d37\u0d46\u0d2f\u0d31\u0d3f\u0d02\u0d17\u0d4d \u0d07\u0d28\u0d4d\u0d31\u0d7c\u0d2b\u0d47\u0d38\u0d3f\u0d32\u0d42\u0d1f\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d15\u0d4d\u0d37\u0d23\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d06\u0d33\u0d41\u0d15\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d42. Lumi Studio-\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d06 \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d4d \u0d06\u0d15\u0d4d\u200c\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d7b \u0d15\u0d34\u0d3f\u0d2f\u0d3f\u0d32\u0d4d\u0d32. \u0d06\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e\u0d15\u0d4d\u0d15\u0d4d \u0d2a\u0d19\u0d4d\u0d15\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d35\u0d30\u0d46 \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d3e\u0d28\u0d4b, \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d7d \u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d3e\u0d28\u0d4b, \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d21\u0d3f\u0d32\u0d40\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d3e\u0d28\u0d4b \u0d15\u0d34\u0d3f\u0d2f\u0d41\u0d02. Apple-\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d35\u0d41\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 iCloud \u0d15\u0d4d\u0d30\u0d2e\u0d40\u0d15\u0d30\u0d23\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d2c\u0d3e\u0d27\u0d15\u0d2e\u0d3e\u0d23\u0d4d."
            },
            {
                "title": "\u0d2a\u0d7c\u0d1a\u0d4d\u0d1a\u0d47\u0d38\u0d41\u0d15\u0d7e",
                "body": "Lifetime Pro \u0d2a\u0d7c\u0d1a\u0d4d\u0d1a\u0d47\u0d38\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2a\u0d41\u0d28\u0d03\u0d38\u0d4d\u0d25\u0d3e\u0d2a\u0d28\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 StoreKit \u0d35\u0d34\u0d3f Apple \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. Lumi Studio-\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d4d \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d2a\u0d47\u0d2f\u0d4d\u200c\u0d2e\u0d46\u0d28\u0d4d\u0d31\u0d4d \u0d15\u0d3e\u0d7c\u0d21\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d32\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d4b \u0d05\u0d35 \u0d38\u0d02\u0d2d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d4b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32. Apple \u0d05\u0d35\u0d30\u0d41\u0d1f\u0d46 \u0d38\u0d4d\u0d35\u0d28\u0d4d\u0d24\u0d02 \u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d28\u0d2f\u0d24\u0d4d\u0d24\u0d3f\u0d28\u0d4d \u0d15\u0d40\u0d34\u0d3f\u0d7d \u0d2a\u0d7c\u0d1a\u0d4d\u0d1a\u0d47\u0d38\u0d4d \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d4d\u0d30\u0d4b\u0d38\u0d38\u0d4d\u0d38\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d47\u0d15\u0d4d\u0d15\u0d3e\u0d02."
            },
            {
                "title": "\u0d28\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d41\u0d15\u0d7e",
                "body": "\u0d31\u0d3f\u0d2e\u0d48\u0d7b\u0d21\u0d7c \u0d28\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d2a\u0d4d\u0d30\u0d3e\u0d26\u0d47\u0d36\u0d3f\u0d15\u0d2e\u0d3e\u0d2f\u0d3f \u0d37\u0d46\u0d21\u0d4d\u0d2f\u0d42\u0d7e \u0d1a\u0d46\u0d2f\u0d4d\u0d24\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d05\u0d35\u0d2f\u0d41\u0d1f\u0d46 '\u0d2a\u0d42\u0d7c\u0d24\u0d4d\u0d24\u0d3f\u0d2f\u0d3e\u0d2f\u0d3f', '\u0d38\u0d4d\u0d28\u0d42\u0d38\u0d4d' \u0d06\u0d15\u0d4d\u0d37\u0d28\u0d41\u0d15\u0d7e \u0d07\u0d24\u0d47 \u0d32\u0d4b\u0d15\u0d4d\u0d15\u0d7d App Group \u0d21\u0d3e\u0d31\u0d4d\u0d31\u0d2f\u0d46 \u0d05\u0d2a\u0d4d\u200c\u0d21\u0d47\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. Mochi DoneStamp \u0d12\u0d30\u0d41 \u0d31\u0d3f\u0d2e\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d28\u0d4b\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d7b \u0d38\u0d46\u0d7c\u0d35\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d06\u0d7c\u0d1f\u0d4d\u0d1f\u0d3f\u0d2b\u0d3f\u0d37\u0d4d\u0d2f\u0d7d \u0d07\u0d28\u0d4d\u0d31\u0d32\u0d3f\u0d1c\u0d7b\u0d38\u0d4d",
                "body": "Mochi DoneStamp \u0d12\u0d30\u0d41 \u0d0e\u0d15\u0d4d\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d47\u0d23\u0d7d AI \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2e\u0d4b\u0d21\u0d7d \u0d2a\u0d4d\u0d30\u0d4a\u0d35\u0d48\u0d21\u0d7c \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d21\u0d3e\u0d31\u0d4d\u0d31 \u0d12\u0d30\u0d41 \u0d2e\u0d4b\u0d21\u0d32\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d1f\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d3f\u0d7d \u0d07\u0d24\u0d4d \u0d12\u0d30\u0d41 \u0d2e\u0d4b\u0d21\u0d32\u0d41\u0d02 \u0d31\u0d7a \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d05\u0d28\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d, \u0d2a\u0d30\u0d38\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d7d, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d3f\u0d02\u0d17\u0d4d",
                "body": "Mochi DoneStamp-\u0d7d \u0d2a\u0d30\u0d38\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d33\u0d4b \u0d05\u0d28\u0d32\u0d3f\u0d31\u0d4d\u0d31\u0d3f\u0d15\u0d4d\u200c\u0d38\u0d4d SDK-\u0d2f\u0d4b \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d1f\u0d4d\u0d1f\u0d3f\u0d32\u0d4d\u0d32, \u0d06\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d4b \u0d35\u0d46\u0d2c\u0d4d\u200c\u0d38\u0d48\u0d31\u0d4d\u0d31\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d4b \u0d09\u0d1f\u0d28\u0d40\u0d33\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d33\u0d46 \u0d1f\u0d4d\u0d30\u0d3e\u0d15\u0d4d\u0d15\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d3f\u0d32\u0d4d\u0d32, \u0d15\u0d42\u0d1f\u0d3e\u0d24\u0d46 \u0d35\u0d4d\u0d2f\u0d15\u0d4d\u0d24\u0d3f\u0d17\u0d24 \u0d35\u0d3f\u0d35\u0d30\u0d19\u0d4d\u0d19\u0d7e \u0d35\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d41\u0d2e\u0d3f\u0d32\u0d4d\u0d32."
            },
            {
                "title": "\u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e, \u0d0e\u0d15\u0d4d\u0d38\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d7e, \u0d12\u0d2a\u0d4d\u0d2a\u0d02 \u0d28\u0d3f\u0d32\u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d7d",
                "body": "\u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d05\u0d35 \u0d06\u0d35\u0d36\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d2e\u0d4d\u0d2a\u0d4b\u0d7e \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d47 \u0d2c\u0d3e\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d02 JSON \u0d0e\u0d15\u0d4d\u0d38\u0d4d\u0d2a\u0d4b\u0d7c\u0d1f\u0d4d\u0d1f\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d38\u0d43\u0d37\u0d4d\u0d1f\u0d3f\u0d15\u0d4d\u0d15\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d24\u0d3f\u0d30\u0d1e\u0d4d\u0d1e\u0d46\u0d1f\u0d41\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d12\u0d30\u0d41 \u0d32\u0d4a\u0d15\u0d4d\u0d15\u0d47\u0d37\u0d28\u0d3f\u0d32\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d47\u0d35\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41\u0d33\u0d4d\u0d33\u0d42. \u0d06 \u0d2b\u0d2f\u0d32\u0d41\u0d15\u0d7e \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d28\u0d3f\u0d2f\u0d28\u0d4d\u0d24\u0d4d\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d21\u0d3f\u0d32\u0d40\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d41\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d41. \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d09\u0d2a\u0d15\u0d30\u0d23\u0d24\u0d4d\u0d24\u0d3f\u0d32\u0d46 \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d4d \u0d0e\u0d21\u0d3f\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d21\u0d3f\u0d32\u0d40\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b, \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d31\u0d40\u0d38\u0d46\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b, \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d iOS \u0d35\u0d34\u0d3f \u0d05\u0d24\u0d4d \u0d28\u0d40\u0d15\u0d4d\u0d15\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46 \u0d05\u0d24\u0d4d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d02. \u0d2a\u0d46\u0d2f\u0d7c \u0d1a\u0d46\u0d2f\u0d4d\u0d24 Apple Watch-\u0d32\u0d46 \u0d06\u0d2a\u0d4d\u0d2a\u0d4d \u0d28\u0d40\u0d15\u0d4d\u0d15\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46\u0d2f\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d38\u0d4d\u0d28\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d2a\u0d15\u0d30\u0d02 \u0d35\u0d46\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46\u0d2f\u0d4b \u0d05\u0d24\u0d3f\u0d32\u0d46 \u0d0f\u0d31\u0d4d\u0d31\u0d35\u0d41\u0d02 \u0d2a\u0d41\u0d24\u0d3f\u0d2f \u0d2a\u0d30\u0d3f\u0d2e\u0d3f\u0d24\u0d2e\u0d3e\u0d2f \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d38\u0d4d\u0d28\u0d3e\u0d2a\u0d4d\u0d2a\u0d4d\u0d37\u0d4b\u0d1f\u0d4d\u0d1f\u0d4d \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d41. Apple-\u0d28\u0d4d\u0d31\u0d46 \u0d38\u0d47\u0d35\u0d28\u0d02 \u0d15\u0d48\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d02 \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d \u0d35\u0d3f\u0d27\u0d47\u0d2f\u0d2e\u0d3e\u0d2f\u0d3f, \u0d28\u0d3f\u0d19\u0d4d\u0d19\u0d7e \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d7d \u0d28\u0d3f\u0d7c\u0d24\u0d4d\u0d24\u0d41\u0d15\u0d2f\u0d4b \u0d05\u0d32\u0d4d\u0d32\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d07\u0d35\u0d28\u0d4d\u0d31\u0d4d \u0d21\u0d3f\u0d32\u0d40\u0d31\u0d4d\u0d31\u0d4d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15\u0d2f\u0d4b \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d4d \u0d35\u0d30\u0d46 \u0d2a\u0d19\u0d4d\u0d15\u0d3f\u0d1f\u0d4d\u0d1f \u0d15\u0d23\u0d4d\u0d1f\u0d28\u0d4d\u0d31\u0d4d CloudKit-\u0d7d \u0d24\u0d41\u0d1f\u0d30\u0d41\u0d02."
            }
        ],
        "contactTitle": "\u0d2c\u0d28\u0d4d\u0d27\u0d2a\u0d4d\u0d2a\u0d46\u0d1f\u0d41\u0d15",
        "contactBody": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d2f\u0d46 \u0d38\u0d02\u0d2c\u0d28\u0d4d\u0d27\u0d3f\u0d1a\u0d4d\u0d1a \u0d1a\u0d4b\u0d26\u0d4d\u0d2f\u0d19\u0d4d\u0d19\u0d7e \u0d07\u0d35\u0d3f\u0d1f\u0d47\u0d15\u0d4d\u0d15\u0d4d \u0d05\u0d2f\u0d15\u0d4d\u0d15\u0d3e\u0d35\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3e\u0d23\u0d4d",
        "contactButton": "\u0d38\u0d4d\u0d35\u0d15\u0d3e\u0d30\u0d4d\u0d2f\u0d24\u0d3e \u0d2a\u0d3f\u0d28\u0d4d\u0d24\u0d41\u0d23 \u0d1f\u0d40\u0d2e\u0d3f\u0d28\u0d4d \u0d07\u0d2e\u0d46\u0d2f\u0d3f\u0d7d \u0d1a\u0d46\u0d2f\u0d4d\u0d2f\u0d41\u0d15"
    }
