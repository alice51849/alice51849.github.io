    "support": {
        "metaTitle": "\uc9c0\uc6d0 - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp\uc758 \ub3c4\uc6c0\ub9d0, \ub2f5\ubcc0 \ubc0f \uc5f0\ub77d\ucc98 \uc815\ubcf4\uc785\ub2c8\ub2e4.",
        "eyebrow": "\uc9c0\uc6d0",
        "heading": "\ubb34\uc5c7\uc744 \ub3c4\uc640\ub4dc\ub9b4\uae4c\uc694?",
        "deviceLine": "iPhone, iPad \ubc0f Apple Watch\uc6a9 Mochi DoneStamp",
        "sections": [
            {
                "title": "\uc774\ubca4\ud2b8\ub97c \uc5b4\ub5bb\uac8c \uae30\ub85d\ud558\ub098\uc694?",
                "body": "\uc774\ubca4\ud2b8 \uce74\ub4dc\uc758 \ub465\uadfc \uccb4\ud06c \ubc84\ud2bc\uc744 \ud0ed\ud558\uc5ec \ud604\uc7ac \uc2dc\uac04\uc744 \uae30\ub85d\ud558\uc138\uc694. \ud558\ub2e8\uc5d0 \uc7a0\uc2dc '\uc2e4\ud589 \ucde8\uc18c' \ubc84\ud2bc\uc774 \ub098\ud0c0\ub0a9\ub2c8\ub2e4. \ub3d9\uc77c\ud55c \ubc84\ud2bc\uc744 \uae38\uac8c \ub204\ub974\uba74 \uc774\uc804 \ub0a0\uc9dc\uc640 \uc2dc\uac04\uc744 \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\ub2e4\uc74c \ubbf8\ub9ac \uc54c\ub9bc\uc774 \uc774\ub3d9\ud55c \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?",
                "body": "\ubaa8\ub4e0 \uc8fc\uae30\ub294 \uc2e4\uc81c \uc644\ub8cc \uc2dc\uac04\ubd80\ud130 \ub2e4\uc2dc \uc2dc\uc791\ub429\ub2c8\ub2e4. 3\uc77c \ub2a6\uac8c \uc644\ub8cc\ud558\uba74 \ub2e4\uc74c \ubbf8\ub9ac \uc54c\ub9bc\uc740 \uc9c0\ub09c \uc77c\uc815\uc744 \uc720\uc9c0\ud558\ub294 \ub300\uc2e0 \uc0c8 \uc2dc\uac04\ubd80\ud130 \uc2dc\uc791\ub429\ub2c8\ub2e4."
            },
            {
                "title": "\ubbf8\ub9ac \uc54c\ub9bc\uc774 \uc624\uc9c0 \uc54a\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?",
                "body": "\uc774\ubca4\ud2b8\ub97c \uc5f4\uace0, '\uc774\ubca4\ud2b8 \uc124\uc815'\uc744 \uc120\ud0dd\ud55c \ub2e4\uc74c, \uc8fc\uae30\uac00 \uc124\uc815\ub418\uc5b4 \uc788\uace0 '\uc54c\ub9bc \ubc1b\uae30'\uac00 \ucf1c\uc838 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694. \uadf8\ub7f0 \ub2e4\uc74c iOS '\uc124\uc815' > '\uc54c\ub9bc' > Mochi DoneStamp\ub97c \ud655\uc778\ud558\uc138\uc694. \uc571\uc740 \ubbf8\ub9ac \uc54c\ub9bc\uc744 \ucf20 \ud6c4\uc5d0\ub9cc \uad8c\ud55c\uc744 \uc694\uccad\ud569\ub2c8\ub2e4."
            },
            {
                "title": "Lifetime Pro\ub97c \uc5b4\ub5bb\uac8c \ubcf5\uc6d0\ud558\ub098\uc694?",
                "body": "Mochi DoneStamp\uc5d0\uc11c '\uc124\uc815'\uc744 \uc5f4\uace0 'Mochi DoneStamp Pro'\ub97c \uc120\ud0dd\ud55c \ub2e4\uc74c '\uad6c\ub9e4 \ubcf5\uc6d0'\uc744 \ud0ed\ud558\uc138\uc694. \uc6d0\ub798 \uad6c\ub9e4\uc5d0 \uc0ac\uc6a9\ud55c \uac83\uacfc \ub3d9\uc77c\ud55c Apple Account\ub97c \uc0ac\uc6a9\ud574\uc57c \ud569\ub2c8\ub2e4. Lifetime Pro\ub294 \uad6c\ub3c5\uc774 \uc544\ub2cc \uc77c\ud68c\uc131 \uad6c\ub9e4\uc785\ub2c8\ub2e4."
            },
            {
                "title": "\ubc31\uc5c5\uc740 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?",
                "body": "Lifetime Pro\ub97c \uc0ac\uc6a9\ud558\uba74 '\uc124\uc815'\uc5d0\uc11c '\ub0b4\ubcf4\ub0b4\uae30'\ub97c \uc120\ud0dd\ud558\uc5ec \uc774\ubca4\ud2b8 \uae30\ub85d\uacfc \uc120\ud0dd\ud55c \uc0ac\uc9c4\uc774 \ud3ec\ud568\ub41c \uc644\uc804\ud55c JSON \ubc31\uc5c5\uc744 \uc0dd\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \uc704\uce58\uc5d0 \ud574\ub2f9 \ud30c\uc77c\uc744 \ubcf4\uad00\ud558\uc138\uc694. \uc774\ub97c \ubcf5\uc6d0\ud558\ub824\uba74 '\uac00\uc838\uc624\uae30'\ub97c \uc120\ud0dd\ud55c \ub2e4\uc74c \ubc31\uc5c5\uc744 '\ud604\uc7ac \ub370\uc774\ud130\uc640 \ud569\uce58\uae30' \ub610\ub294 '\ud604\uc7ac \ub370\uc774\ud130 \ub300\uccb4'\ub97c \uc218\ud589\ud558\uc138\uc694."
            },
            {
                "title": "\uac00\uc871 \uacf5\uc720\ub294 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub098\uc694?",
                "body": "\uc774\ubca4\ud2b8\ub97c \uc5f4\uace0 \uc0ac\ub78c \uc544\uc774\ucf58\uc744 \ud0ed\ud55c \ub2e4\uc74c '\uac00\uc871\uacfc \uacf5\uc720'\ub97c \uc120\ud0dd\ud558\uc138\uc694. Apple\uc5d0\uc11c \ucd08\ub300 \ubc0f \ucc38\uac00\uc790 \uc81c\uc5b4 \ud654\uba74\uc744 \ud45c\uc2dc\ud569\ub2c8\ub2e4. \uc0ac\uc9c4\uc740 CloudKit \uacf5\uc720\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub3d9\uc77c\ud55c \uc774\ubca4\ud2b8\uc5d0\uc11c \ucc38\uac00\uc790\ub97c \uad00\ub9ac\ud558\uac70\ub098 \uacf5\uc720\ub97c \uc911\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "Apple Watch\uc5d0\uc11c \ubb34\uc5c7\uc744 \ud560 \uc218 \uc788\ub098\uc694?",
                "body": "\ucef4\ud328\ub2c8\uc5b8 \uc571\uc740 \ud398\uc5b4\ub9c1\ub41c iPhone\uacfc \ub3d9\uae30\ud654\ub41c \uc774\ubca4\ud2b8\ub97c \ubcf4\uc5ec\uc90d\ub2c8\ub2e4. \uc190\ubaa9\uc5d0\uc11c \uccb4\ud06c \ubc84\ud2bc\uc744 \ud0ed\ud558\uc5ec \uc774\ubca4\ud2b8\ub97c \uae30\ub85d\ud558\uc138\uc694. \ubcc0\uacbd \uc0ac\ud56d\uc740 iPhone\uc73c\ub85c \uc804\uc1a1\ub418\uba70 \uc77c\uc2dc\uc801\uc73c\ub85c \uc5f0\uacb0\uc774 \ub04a\uae34 \ub3d9\uc548\uc5d0\ub3c4 \ucd5c\uc2e0 \uc774\ubca4\ud2b8 \ubaa9\ub85d\uc744 \uacc4\uc18d \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            }
        ],
        "contactTitle": "\uc5f0\ub77d\ucc98",
        "contactBody": "iOS \ub610\ub294 watchOS \ubc84\uc804, \uae30\uae30 \ubaa8\ub378, \uadf8\ub9ac\uace0 \ubc1c\uc0dd\ud55c \ubb38\uc81c\uc5d0 \ub300\ud55c \uac04\ub2e8\ud55c \uc124\uba85\uc744 \ud3ec\ud568\ud574 \uc8fc\uc138\uc694. \uc694\uccad\uc5d0 \ubc18\ub4dc\uc2dc \ud544\uc694\ud55c \uacbd\uc6b0\uac00 \uc544\ub2c8\ub77c\uba74 \uac1c\uc778\uc801\uc778 \uba54\ubaa8, \uc0ac\uc9c4, \ubc31\uc5c5 \ud30c\uc77c\uc740 \ubcf4\ub0b4\uc9c0 \ub9c8\uc138\uc694.",
        "contactButton": "\uc9c0\uc6d0\ud300\uc5d0 \uc774\uba54\uc77c \ubcf4\ub0b4\uae30"
    },
    "privacy": {
        "metaTitle": "\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68 - Mochi DoneStamp",
        "metaDescription": "Mochi DoneStamp \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68: \uacc4\uc815 \uc5c6\uc74c, \uad11\uace0 \uc5c6\uc74c, \ubd84\uc11d \uc5c6\uc74c, \ucd94\uc801 \uc5c6\uc74c.",
        "eyebrow": "\uac1c\uc778\uc815\ubcf4 \ubcf4\ud638",
        "heading": "\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68",
        "effectiveDate": "\uc2dc\ud589\uc77c: 2026\ub144 7\uc6d4 17\uc77c",
        "sections": [
            {
                "title": "\uc694\uc57d",
                "body": "Mochi DoneStamp\ub294 \uacc4\uc815\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc73c\uba70 \uad11\uace0, \ubd84\uc11d, \ucd94\uc801 \ub610\ub294 \ud0c0\uc0ac SDK\ub97c \ud3ec\ud568\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc624\ud504\ub77c\uc778 \uc0ac\uc6a9\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4. Lumi Studio\ub294 \uc571\uc744 \uc704\ud55c \uc11c\ubc84\ub97c \uc6b4\uc601\ud558\uc9c0 \uc54a\uc73c\uba70 \uae30\uae30 \ub0b4 \ucf58\ud150\uce20\ub97c \uc77d\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\uae30\uae30\uc5d0 \uc800\uc7a5\ub418\ub294 \ub370\uc774\ud130",
                "body": "\uc774\ubca4\ud2b8 \uc774\ub984, \uae30\ud638, \uc0c9\uc0c1, \uc8fc\uae30, \ubbf8\ub9ac \uc54c\ub9bc \uc124\uc815, \uc644\ub8cc \uae30\ub85d, \uba54\ubaa8, \uc120\ud0dd\ud55c \uc0ac\uc9c4\uc740 \uc571\uc758 \ubcf4\ud638\ub41c App Group \ucee8\ud14c\uc774\ub108\uc5d0 \uc800\uc7a5\ub418\ubbc0\ub85c \uc571, \uc704\uc82f, \uc54c\ub9bc \uc791\uc5c5, App Intents\uac00 \ub3d9\uc77c\ud55c \ub370\uc774\ud130\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ucd5c\ub300 50\uac1c\uc758 \uc774\ubca4\ud2b8\ub85c \uad6c\uc131\ub41c \uc81c\ud55c\ub41c \uc2a4\ub0c5\uc0f7\uc774 Apple\uc758 WatchConnectivity \uc11c\ube44\uc2a4\ub97c \ud1b5\ud574 \ud398\uc5b4\ub9c1\ub41c Apple Watch\ub85c \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc5ec\uae30\uc5d0\ub294 \uc774\ubca4\ud2b8 \uc774\ub984, \uae30\ud638, \uc0c9\uc0c1, \uc644\ub8cc \ubc0f \uae30\ud55c \uc2dc\uac04, \uae30\ud55c \uacbd\uacfc, \uace0\uc815 \ubc0f \uacf5\uc720 \uc0c1\ud0dc, \uc120\ud0dd\uc801 \uc644\ub8cc\uc790 \uc774\ub984 \ubc0f \uc571 \uc5b8\uc5b4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uba54\ubaa8\uc640 \uc0ac\uc9c4\uc740 Watch\ub85c \uc804\uc1a1\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Watch\uc5d0\uc11c \uc774\ubca4\ud2b8\ub97c \uae30\ub85d\ud558\uba74 WatchConnectivity\ub97c \ud1b5\ud574 \uc774\ubca4\ud2b8 \ubc0f \ubc1c\uc0dd \uc2dd\ubcc4\uc790\uc640 \uc644\ub8cc \uc2dc\uac04\uc774 \ud398\uc5b4\ub9c1\ub41c iPhone\uc73c\ub85c \ub2e4\uc2dc \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc774 \ucf58\ud150\uce20\ub294 \ubaa8\ub450 Lumi Studio\ub85c \uc804\uc1a1\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\uc0ac\uc9c4",
                "body": "\uc0ac\uc9c4\uc740 \uc120\ud0dd \uc0ac\ud56d\uc774\uba70 \uc9c1\uc811 \uc120\ud0dd\ud569\ub2c8\ub2e4. Mochi DoneStamp\ub294 \uc774\ubca4\ud2b8 \uae30\ub85d\uc744 \uc704\ud55c \uc555\ucd95\ub41c \ube44\uacf5\uac1c \uc0ac\ubcf8\uc744 \ub9cc\ub4ed\ub2c8\ub2e4. \uc120\ud0dd\ud55c \uc0ac\uc9c4\uc744 Lumi Studio\uc5d0 \uc5c5\ub85c\ub4dc\ud558\uac70\ub098 CloudKit \uac00\uc871 \uacf5\uc720\uc5d0 \ud3ec\ud568\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "iCloud\ub97c \ud1b5\ud55c \uc120\ud0dd\uc801 \uac00\uc871 \uacf5\uc720",
                "body": "\uac00\uc871 \uacf5\uc720\ub294 '\uac00\uc871\uacfc \uacf5\uc720'\ub97c \uc120\ud0dd\ud55c \ud6c4\uc5d0\ub9cc \uc2dc\uc791\ub429\ub2c8\ub2e4. \uadf8\ub7f0 \ub2e4\uc74c Apple\uc758 \ube44\uacf5\uac1c \ubc0f \uacf5\uc720 CloudKit \ub370\uc774\ud130\ubca0\uc774\uc2a4\uac00 \uc774\ubca4\ud2b8 \ubc0f \ubc1c\uc0dd \uc2dd\ubcc4\uc790, \uc774\ubca4\ud2b8 \uc774\ub984, \uae30\ud638, \uc0c9\uc0c1, \ud45c\uc2dc \uc21c\uc11c, \uace0\uc815 \ub610\ub294 \ubcf4\uad00 \uc0c1\ud0dc, \ubc18\ubcf5 \ubc0f \ubbf8\ub9ac \uc54c\ub9bc \uc124\uc815, \uc0dd\uc131 \ubc0f \uc5c5\ub370\uc774\ud2b8 \uc2dc\uac04, \uc644\ub8cc \uc2dc\uac04, \ucd9c\ucc98, \uba54\ubaa8, \ucc38\uac00\uc790 \uc2dd\ubcc4\uc790 \ubc0f \ud45c\uc2dc \uc774\ub984\uc744 \ucc98\ub9ac\ud569\ub2c8\ub2e4. \uc120\ud0dd\ud55c \uc0ac\uc9c4\uc740 \uc5c5\ub85c\ub4dc\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Apple\uc758 \uacf5\uc720 \uc778\ud130\ud398\uc774\uc2a4\ub97c \ud1b5\ud574 \ucd08\ub300\ud55c \uc0ac\ub78c\ub9cc \uacf5\uc720 \uc774\ubca4\ud2b8\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Lumi Studio\ub294 \ud574\ub2f9 \ucf58\ud150\uce20\uc5d0 \uc811\uadfc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc571\uc5d0\uc11c \ucc38\uac00\uc790\ub97c \uad00\ub9ac\ud558\uac70\ub098, \uacf5\uc720\ub97c \uc911\uc9c0\ud558\uac70\ub098, \uacf5\uc720 \uc774\ubca4\ud2b8\ub97c \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. Apple\uc758 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68\uacfc \uc0ac\uc6a9\uc790\uc758 iCloud \uc124\uc815\ub3c4 \uc801\uc6a9\ub429\ub2c8\ub2e4."
            },
            {
                "title": "\uad6c\ub9e4",
                "body": "Lifetime Pro \uad6c\ub9e4 \ubc0f \ubcf5\uc6d0\uc740 StoreKit\uc744 \ud1b5\ud574 Apple\uc5d0\uc11c \ucc98\ub9ac\ud569\ub2c8\ub2e4. Lumi Studio\ub294 \uc0ac\uc6a9\uc790\uc758 \uacb0\uc81c \uce74\ub4dc \uc138\ubd80 \uc815\ubcf4\ub97c \uc218\uc2e0\ud558\uac70\ub098 \uc800\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. Apple\uc740 \uc790\uccb4 \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68\uc5d0 \ub530\ub77c \uad6c\ub9e4 \uc815\ubcf4\ub97c \ucc98\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\uc54c\ub9bc",
                "body": "\ubbf8\ub9ac \uc54c\ub9bc \uc54c\ub9bc\uc740 \uae30\uae30\uc5d0 \ub85c\uceec\ub85c \uc608\uc57d\ub429\ub2c8\ub2e4. \ud574\ub2f9 '\uc644\ub8cc' \ubc0f '\ub098\uc911\uc5d0 \uc54c\ub9bc' \uc791\uc5c5\uc740 \ub3d9\uc77c\ud55c \ub85c\uceec App Group \ub370\uc774\ud130\ub97c \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4. Mochi DoneStamp\ub294 \uc6d0\uaca9 \uc54c\ub9bc \uc11c\ubc84\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\uc778\uacf5 \uc9c0\ub2a5",
                "body": "Mochi DoneStamp\ub294 \uc678\ubd80 AI \ub610\ub294 \ubaa8\ub378 \uc81c\uacf5\uc5c5\uccb4\ub97c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc73c\uba70 \uc0ac\uc6a9\uc790\uc758 \ub370\uc774\ud130\ub97c \ubaa8\ub378\ub85c \uc804\uc1a1\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub610\ud55c \uae30\uae30\uc5d0\uc11c \uc0ac\uc6a9\uc790 \ucf58\ud150\uce20\uc5d0 \ub300\ud574 \ubaa8\ub378\uc744 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\ubd84\uc11d, \uad11\uace0 \ubc0f \ucd94\uc801",
                "body": "Mochi DoneStamp\uc5d0\ub294 \uad11\uace0 \ub610\ub294 \ubd84\uc11d SDK\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc73c\uba70 \uc571\uc774\ub098 \uc6f9\uc0ac\uc774\ud2b8\uc5d0\uc11c \uc0ac\uc6a9\uc790\ub97c \ucd94\uc801\ud558\uc9c0 \uc54a\uace0 \uac1c\uc778 \uc815\ubcf4\ub97c \ud310\ub9e4\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
            },
            {
                "title": "\ubc31\uc5c5, \ub0b4\ubcf4\ub0b4\uae30 \ubc0f \ubcf4\uad00",
                "body": "\ubc31\uc5c5 \ubc0f JSON \ub0b4\ubcf4\ub0b4\uae30\ub294 \uc694\uccad \uc2dc\uc5d0\ub9cc \uc0dd\uc131\ub418\uba70 \uc120\ud0dd\ud55c \uc704\uce58\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \uc774\ub7ec\ud55c \ud30c\uc77c\uc744 \uc81c\uc5b4\ud558\uace0 \uc0ad\uc81c\ud569\ub2c8\ub2e4. \uae30\uae30 \ub0b4 \ucf58\ud150\uce20\ub294 \ud3b8\uc9d1, \uc0ad\uc81c, \uc571 \ucd08\uae30\ud654 \ub610\ub294 iOS\ub97c \ud1b5\ud574 \uc81c\uac70\ud560 \ub54c\uae4c\uc9c0 \uc720\uc9c0\ub429\ub2c8\ub2e4. \ud398\uc5b4\ub9c1\ub41c Apple Watch\ub294 \ub354 \uc0c8\ub85c\uc6b4 \uc2a4\ub0c5\uc0f7\uc73c\ub85c \uad50\uccb4\ub418\uac70\ub098 Watch \uc571\uc774 \uc81c\uac70\ub420 \ub54c\uae4c\uc9c0 \ucd5c\uc2e0 \uc81c\ud55c\ub41c \uc774\ubca4\ud2b8 \uc2a4\ub0c5\uc0f7\uc744 \ubcf4\uad00\ud569\ub2c8\ub2e4. \uacf5\uc720 \ucf58\ud150\uce20\ub294 \uacf5\uc720\ub97c \uc911\uc9c0\ud558\uac70\ub098 \uacf5\uc720 \uc774\ubca4\ud2b8\ub97c \uc0ad\uc81c\ud560 \ub54c\uae4c\uc9c0 CloudKit\uc5d0 \ub0a8\uc544 \uc788\uc73c\uba70 Apple\uc758 \uc11c\ube44\uc2a4 \ucc98\ub9ac\uc5d0 \ub530\ub985\ub2c8\ub2e4."
            }
